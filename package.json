{
  "name": "sparko",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dev": "concurrently -n web,api \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @sparko/web dev",
    "dev:api": "pnpm --filter @sparko/api dev",
    "dev:bot": "pnpm --filter @sparko/bot dev",
    "dev:worker": "pnpm --filter @sparko/worker dev",
    "typecheck": "pnpm -r typecheck && tsc -p tools/tsconfig.json",
    "lint": "eslint apps packages tools --max-warnings 0",
    "format:check": "prettier --check apps packages tools infra docs *.json *.yaml .github",
    "format": "prettier --write apps packages tools infra docs *.json *.yaml .github",
    "build": "pnpm db:generate && pnpm -r build && tsx tools/prerender.ts && tsx tools/check-boundaries.ts",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "tsx tools/test-integration.ts",
    "test:e2e": "playwright test",
    "db:generate": "tsx tools/generate-client.ts",
    "db:migrate": "pnpm --filter @sparko/db migrate",
    "db:seed": "tsx tools/seed.ts",
    "discord:register": "tsx apps/bot/src/register.ts",
    "backup": "tsx tools/backup.ts",
    "restore:verify": "tsx tools/restore.ts",
    "smoke": "tsx tools/smoke.ts",
    "load": "tsx tools/load.ts"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.21.0",
    "vitest": "5.0.3",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "eslint": "10.12.0",
    "typescript-eslint": "8.71.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.7.4",
    "concurrently": "9.2.1",
    "@types/node": "24.10.1",
    "@sparko/db": "workspace:*",
    "@sparko/domain": "workspace:*",
    "@sparko/contracts": "workspace:*",
    "@sparko/messages": "workspace:*",
    "@sparko/config": "workspace:*",
    "@sparko/policy": "workspace:*",
    "@sparko/assets": "workspace:*",
    "pg": "8.23.1",
    "@types/pg": "8.15.6",
    "ioredis": "6.0.0",
    "dotenv": "17.2.3"
  }
}
