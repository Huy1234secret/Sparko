generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id
  username String
  avatar String?
  preferences Json @default("{}")
  createdAt DateTime @default(now())
  sessions Session[]
  credentials OAuthCredential?
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  csrfHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
model OAuthCredential {
  userId String @id
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  encryptedToken String
  encryptedRefresh String
  expiresAt DateTime
  revision Int @default(0)
  refreshLeaseId String?
  refreshLeaseUntil DateTime?
}
model OAuthState {
  id String @id
  verifierHash String
  returnTo String
  expiresAt DateTime
}
model Guild {
  id String @id
  name String
  installed Boolean @default(false)
  observedAt DateTime?
  memberCount Int?
  createdAt DateTime @default(now())
  configs FeatureConfig[]
  records Record[]
  grants AccessGrant[]
  operations Operation[]
  tickets Ticket[]
  publications Publication[]
  templates Template[]
  controls IssuedControl[]
  outbox Outbox[]
  audits AuditLog[]
  ledgerAccounts LedgerAccount[]
  ledgerTransactions LedgerTransaction[]
}
model AccessGrant {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  subjectId String
  subjectType String
  capabilities String[]
  expiresAt DateTime?
  @@unique([guildId, subjectType, subjectId])
}
model GlobalGrant {
  userId String @id
  capabilities String[]
  expiresAt DateTime?
}
model FeatureConfig {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  featureId String
  revision Int @default(0)
  appliedRevision Int @default(0)
  config Json
  updatedAt DateTime @updatedAt
  @@unique([guildId, featureId])
}
model Record {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  kind String
  key String
  ownerId String?
  state String @default("active")
  revision Int @default(1)
  data Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([guildId, kind, key])
  @@index([guildId, kind, createdAt, id])
  @@index([guildId, kind, ownerId, state])
}
model Operation {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorId String
  scope String
  key String
  requestHash String
  result Json?
  businessStatus String @default("committed")
  deliveryStatus String @default("pending")
  createdAt DateTime @default(now())
  @@unique([guildId, actorId, scope, key])
  @@index([guildId, createdAt, id])
}
model Outbox {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  operationId String?
  type String
  payload Json
  state String @default("pending")
  dueAt DateTime @default(now())
  leaseUntil DateTime?
  fence Int @default(0)
  attempts Int @default(0)
  lastError String?
  createdAt DateTime @default(now())
  @@index([state, dueAt, leaseUntil])
}
model AuditLog {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  actorId String
  action String
  summary Json
  operationId String?
  createdAt DateTime @default(now())
  @@index([guildId, createdAt, id])
}
model Template {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  name String
  revision Int @default(1)
  archived Boolean @default(false)
  versions TemplateVersion[]
  createdAt DateTime @default(now())
  @@index([guildId, createdAt, id])
}
model TemplateVersion {
  id String @id @default(uuid())
  templateId String
  template Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  number Int
  document Json
  createdAt DateTime @default(now())
  @@unique([templateId, number])
}
model Publication {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  channelId String
  messageId String?
  document Json
  templateVersionId String?
  revision Int @default(1)
  appliedRevision Int @default(0)
  state String @default("pending")
  test Boolean @default(false)
  createdAt DateTime @default(now())
  controls IssuedControl[]
  @@index([guildId, createdAt, id])
}
model IssuedControl {
  id String @id
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  publicationId String
  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Restrict)
  key String
  action Json
  actorId String?
  revoked Boolean @default(false)
  expiresAt DateTime?
  @@unique([publicationId, key])
}
model Ticket {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  number Int
  ownerId String
  channelId String?
  claimantId String?
  state String @default("creating")
  revision Int @default(1)
  snapshot Json
  answers Json
  participants String[]
  closeReason String?
  createdAt DateTime @default(now())
  closedAt DateTime?
  @@unique([guildId, number])
  @@index([guildId, ownerId, state])
}
model Transcript {
  id String @id @default(uuid())
  guildId String
  ticketId String
  messages Json
  status String
  checksum String
  createdAt DateTime @default(now())
  expiresAt DateTime
  @@index([guildId, ticketId])
}
model SupportTicket {
  id String @id @default(uuid())
  ownerId String
  subject String
  category String
  state String @default("open")
  messages Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([ownerId, createdAt, id])
}
model Heartbeat {
  service String @id
  version String
  status String
  details Json
  updatedAt DateTime @updatedAt
}
model LedgerAccount {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  ownerId String
  currency String @default("spark")
  balance BigInt @default(0)
  system Boolean @default(false)
  entries LedgerEntry[]
  @@unique([guildId, ownerId, currency])
}
model LedgerTransaction {
  id String @id @default(uuid())
  guildId String
  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  key String
  kind String
  entries LedgerEntry[]
  createdAt DateTime @default(now())
  @@unique([guildId, key])
}
model LedgerEntry {
  id String @id @default(uuid())
  transactionId String
  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  accountId String
  account LedgerAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  amount BigInt
  @@index([accountId, transactionId])
}
model AccountRequest {
  id String @id @default(uuid())
  userId String
  kind String
  state String @default("requested")
  data Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, kind, createdAt])
}
