NODE_ENV=development
APP_VERSION=0.1.0
PUBLIC_APP_URL=http://localhost:5173
VITE_API_BASE_URL=/api/v1
PORT=3001
DATABASE_URL=postgresql://sparko:replace-local-password@localhost:5432/sparko
REDIS_URL=redis://localhost:6379
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:5173/api/v1/auth/discord/callback
DISCORD_TEST_GUILD_ID=
# Generate independently; never use these descriptions as keys.
SESSION_SECRET=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-64-hex-characters
OWNER_USER_IDS=
TRUST_PROXY=false
STORAGE_PATH=.data/private
LOG_LEVEL=info
# Explicit disposable test targets only. Tests reject nonlocal or nonsuffixed databases.
TEST_DATABASE_URL=postgresql://sparko:sparko@localhost:55432/sparko_test
TEST_REDIS_URL=redis://localhost:56379/15
# Optional providers; absence must disable their capabilities.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1
SOCIAL_ALLOWED_HOSTS=
